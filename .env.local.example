# Copy this file to .env.local and fill in your values
# .env.local is gitignored — never commit real secrets

# ── Supabase (required for realtime orders, menu CRUD, analytics) ─────────────
# Find these in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only (analytics SSR)

# ── Razorpay (optional — simulated payment works without these) ───────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ── Admin PIN (default: 2518) ─────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_PIN=2518

# ── Base URL (your deployed Vercel domain) ──────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://your-project.vercel.app

# ── Total Tables (default: 12) ──────────────────────────────────────────────
NEXT_PUBLIC_TOTAL_TABLES=12

# ── Weather API (optional — falls back to sunny if missing) ──────────────────
OPENWEATHER_API_KEY=your-openweather-key
